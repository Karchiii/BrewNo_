.modal-dialog(role="document")
  .modal-content
    .modal-header
      button.close(type="button" ,data-dismiss="modal",aria-label="Close")
        span(aria-hidden="true") &times;
      h4.modal-title(id="propertiesLabel") #{modalDialog.title}
    .modal-body
      block content
    .modal-footer
      block footer
